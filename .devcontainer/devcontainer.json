{
	"name": "Advent of Code",
	"dockerComposeFile": "docker-compose.yml",
	"service": "devcontainer",
	"workspaceFolder": "/workspace",
	"forwardPorts": [
		3000,
		5173,
		5197
	],
	"features": {
    	"ghcr.io/anthropics/devcontainer-features/claude-code": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"mhutchie.git-graph",
				"Ionide.Ionide-fsharp",
				"anthropic.claude-code"
			]
		}
	}
}