{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Driver",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-driver",
            "program": "${workspaceFolder}/bin/Debug/net10.0/Driver.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "ColorPuzzle API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-colorpuzzle-api",
            "program": "${workspaceFolder}/ColorPuzzle/Api/bin/Debug/net10.0/Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/ColorPuzzle/Api",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5197"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
